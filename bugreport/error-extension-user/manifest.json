{
  "manifest_version": 3,
  "name": "BugReport Collector",
  "version": "1.0",
  "description": "Collect and send bug reports with screenshot, console logs and metadata",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Report a bug"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject-logger.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.js"],
      "matches": ["<all_urls>"]
    }
  ]
}